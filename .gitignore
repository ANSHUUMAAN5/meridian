# ── Secrets — never commit ──
.env
.env.*
!.env.example
!frontend/.env.example
*.pem
*.key
secrets/

# ── Python ──
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / Next.js ──
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel

# ── Next.js auto-generated AI-tool files (regenerated by `next dev`) ──
frontend/AGENTS.md
frontend/CLAUDE.md

# ── Models & caches (fastembed downloads ONNX weights at runtime) ──
.cache/
models/
*.onnx

# ── Eval outputs (results are regenerated; baseline is committed explicitly) ──
sextant/results/
!sextant/results/baseline.json

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Coding-tool internals — not project code ──
.claude/
.agents/
skills-lock.json

# ── Personal learning notes — for me, not for the repo ──
notes/
