# ── Database ──────────────────────────────────────────────────────────
# Neon → your project → Connection string → "Pooled connection"
# Paste it EXACTLY as Neon gives it — do not edit it. The app rewrites the
# driver prefix and ssl parameters itself (Settings._normalise_pg_url).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────
# Any long random string. Generate:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=1440

# ── LLM providers ─────────────────────────────────────────────────────
# Compass (routing) runs on Groq — console.groq.com
GROQ_API_KEY=gsk_REPLACE_ME
# Almanac / Manifest (answering) run on Gemini — aistudio.google.com
GEMINI_API_KEY=REPLACE_ME

# Local fallback for offline smoke tests. No key needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Which provider each agent uses: groq | gemini | ollama
COMPASS_PROVIDER=ollama
ANSWER_PROVIDER=ollama

# ── Threshold (§6.2) — swept against the eval set, not guessed ────────
TAU_ROUTE=0.75
TAU_ANSWER=0.70

# ── Retrieval ─────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
CHUNK_TOKENS=600
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=6
